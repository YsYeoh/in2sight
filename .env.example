# in2sight environment template.
#
#   1. Copy this file to `.env.local` (git-ignored — never commit real values):
#        cp .env.example .env.local
#   2. Fill in the values using docs/SETUP.md (order of steps), docs/SETUP_SUPABASE.md and docs/META_SETUP.md.
#   3. Check your work (prints only OK / problems — never a value):
#        npm run check:env
#
# Production: the SAME names go into Vercel -> Project -> Settings -> Environment Variables.
# Do NOT paste secret values into chat, issues or commits. Put them in .env.local / Vercel only.

# ------------------------------------------------------------------ App
# Public URL of the deployed app, no trailing slash. For local work use http://localhost:3000.
# Used for the Instagram OAuth redirect, PWA and report links.
NEXT_PUBLIC_APP_URL=

# ------------------------------------------------------------------ Supabase  (docs/SETUP_SUPABASE.md)
# Supabase dashboard -> Project Settings -> API (Data API): Project URL, e.g. https://abcdefghijklmnopqrst.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
# Project Settings -> API Keys -> "Publishable key" (starts with sb_publishable_). Safe for the browser.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Project Settings -> API Keys -> "Secret keys" (starts with sb_secret_). SERVER ONLY — bypasses row-level security.
SUPABASE_SECRET_KEY=
# The 20-character project reference (the part before .supabase.co). Used by the Supabase CLI / tooling.
SUPABASE_PROJECT_REF=
# Optional, only if you want to run migrations with the Supabase CLI instead of letting Claude apply them
# through the connected Supabase tool: Account -> Access Tokens, and the database password from project creation.
SUPABASE_ACCESS_TOKEN=
SUPABASE_DB_PASSWORD=

# ------------------------------------------------------------------ Security
# A long random string that the Supabase scheduler sends when it calls our cron endpoints. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=

# ------------------------------------------------------------------ Meta / Instagram  (docs/META_SETUP.md)
# Meta dashboard -> your app -> Instagram -> "API setup with Instagram business login":
# the INSTAGRAM app ID and INSTAGRAM app secret (these are NOT the Meta app ID / Meta app secret under App settings -> Basic).
IG_APP_ID=
IG_APP_SECRET=
# Graph API version used for calls (current as of Oct 2026; Meta's docs show v25.0).
IG_API_VERSION=v25.0
# Must equal NEXT_PUBLIC_APP_URL + /api/instagram/callback, and be listed (exactly, same characters) under
# "Business login settings" -> OAuth redirect URIs in the Meta dashboard.
IG_REDIRECT_URI=

# ------------------------------------------------------------------ Optional — needed in later plans (leave empty until then)
# Web Push (alerts). Generate once with:  npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
# Signs the short-lived links used to render PDF reports (any long random string, same generator as CRON_SECRET).
REPORT_SIGNING_SECRET=
